MINIMAX_API_KEY=replace_with_your_minimax_api_key
MINIMAX_API_BASE_URL=https://api.minimax.io
MINIMAX_CONNECT_TIMEOUT_SECONDS=10
MINIMAX_READ_TIMEOUT_SECONDS=120
MINIMAX_VOICE_CACHE_SECONDS=300
MINIMAX_MAX_SEGMENTS=50

BYTEPLUS_API_KEY=replace_with_your_byteplus_api_key
BYTEPLUS_API_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
BYTEPLUS_TTS_RESOURCE_ID=seed-tts-2.0
BYTEPLUS_TTS_USER_ID=concierge-audio
BYTEPLUS_CONNECT_TIMEOUT_SECONDS=10
BYTEPLUS_READ_TIMEOUT_SECONDS=120
BYTEPLUS_MAX_SEGMENTS=50

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
